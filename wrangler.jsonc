{
  "name": "thevenueportal",
  "account_id": "cd1d3c368a7c9ce0f24875b6c87feb69",
  "main": "api.js",
  "compatibility_date": "2024-01-01",
  "workers_dev": true,
  "vars": {
    "FRONTEND_URL": "https://venueportal.us"
  },
  "routes": [
    { "pattern": "api.venueportal.us/*", "zone_name": "venueportal.us" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "venue-portal-db",
      "database_id": "5253aacd-dc38-4de0-9bc8-20062e0b3193"
    }
  ],
  "r2_buckets": [
    {
      "binding": "VENUE_PHOTOS",
      "bucket_name": "venue-photos"
    }
  ]
}
